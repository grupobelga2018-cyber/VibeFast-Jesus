# ============================================================
# Color Hair by Gabby — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
# Local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Producción (Vercel → Environment Variables):
# NEXT_PUBLIC_APP_URL=https://TU-PROYECTO.vercel.app

# --- Supabase ---
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Resend (email) ---
RESEND_API_KEY=

# --- PostHog (opcional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Booking · Calendly ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tu-usuario
CALENDLY_WEBHOOK_SIGNING_KEY=
# Token personal: Calendly → Integraciones y apps → API y webhooks → Token de acceso personal
# Hace falta plan de pago para crear citas con POST /invitees.
CALENDLY_API_TOKEN=
# Opcional. Si lo dejas vacío se usa el primer event type activo.
CALENDLY_EVENT_TYPE_URI=

# --- Booking · Telegram bot ---
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=ColorHairGabbyBot
NEXT_PUBLIC_TELEGRAM_DEEP_LINK=https://t.me/ColorHairGabbyBot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# Pega aquí el chat ID de Gaby (el que te da el bot con /id).
# Prod: POST https://TU-PROYECTO.vercel.app/api/telegram/setup?key=TELEGRAM_WEBHOOK_SECRET
# Local (opcional, pausa el bot de Vercel): TELEGRAM_LOCAL_POLLER=1
TELEGRAM_LOCAL_POLLER=

# --- Cron (Vercel) ---
# Cadena larga aleatoria. Vercel la envía como Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# --- Google Calendar (citas del bot) ---
# Mismos client id/secret que el login con Google de Supabase.
# En Google Cloud: habilita Google Calendar API y agrega el scope
# https://www.googleapis.com/auth/calendar.events a la pantalla de consentimiento.
# Luego, en el dashboard, pulsa “Conectar Google Calendar”.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional. Por defecto se usa el calendario principal de la cuenta conectada.
GOOGLE_CALENDAR_ID=primary
